# GitHub API Personal Access Token (Optional: increases rate limit from 60 to 5,000 requests/hour)
# Never prefix with NEXT_PUBLIC_ to keep it secure on the server!
GITHUB_TOKEN=

# Gemini API Key (Optional: for stretch goal AI persona roast enrichment)
# Never prefix with NEXT_PUBLIC_!
GEMINI_API_KEY=

# Public App Base URL (Optional: defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
